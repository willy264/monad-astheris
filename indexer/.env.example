ENVIO_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
ENVIO_AGENT_REGISTRY_ADDRESS=
ENVIO_ROUTER_ADDRESS=
ENVIO_START_BLOCK=0
# Envio Cloud supplies HyperSync access; local HyperSync use requires your token.
ENVIO_API_TOKEN=
# Read-only GraphQL aggregate access used by the dashboard. No admin secret is required
# when the deployment exposes these aggregates to its configured public read role.
ENVIO_HASURA_PUBLIC_AGGREGATE=["Agent","TaskExecution"]
# Keep Hasura away from daemon port 8080.
HASURA_EXTERNAL_PORT=8081
HASURA_GRAPHQL_ENDPOINT=http://localhost:8081/v1/metadata
# Local development only. Set a private value for self-hosted deployments.
HASURA_GRAPHQL_ADMIN_SECRET=aetheris-local-dev
