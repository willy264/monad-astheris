# Deploy contracts first. No transaction is sent until the RPC chain and code are checked.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
AETHERIS_ROUTER_ADDRESS=
DEPLOYMENT_BLOCK=
# Comma-separated private keys (64 hex digits, optional 0x prefix), without quotes.
# Each key must be exclusive to this daemon process.
# Fund with testnet MON, then have each agent owner call setDelegate for its executor.
RELAYER_PRIVATE_KEYS=
# Default: 127.0.0.1:8080 locally; 0.0.0.0:PORT when the host supplies PORT.
# LISTEN_ADDR overrides PORT. On Render, remove this override or set 0.0.0.0:10000.
# LISTEN_ADDR=127.0.0.1:8080
CORS_ORIGIN=http://localhost:3000
# Parent must already exist. Render: mount a persistent disk at /var/data and use
# /var/data/aetheris.redb. Never replace or discard the journal to fix startup.
DATABASE_PATH=aetheris.redb
MAX_INFLIGHT=32
CONFIRMATIONS=12
# First relayer must hold the router's batch publisher role. RPC must support finalized.
BATCH_ENABLED=false
RUST_LOG=aetheris_daemon=info,tower_http=info

# No free/unsigned mode. Start with a facilitator that actually supports exact EIP3009
# on chain 10143. The service checks GET /supported and refuses unsupported deployments.
PAYMENT_MODE=x402
PUBLIC_TASK_URL=http://localhost:8080/v1/tasks
X402_FACILITATOR_URL=
X402_FACILITATOR_TOKEN=
PAYMENT_ASSET=
PAYMENT_ASSET_NAME=
PAYMENT_ASSET_VERSION=
PAYMENT_RECEIVER=
PAYMENT_AMOUNT=1000

# Optional Graph Tally v2 mode replaces x402 exact payments. These are actual Graph
# deployment/domain values, not the Monad router. No Graph Tally Monad deployment
# or native x402 Graph Tally scheme is assumed.
# PAYMENT_MODE=graph-tally
GRAPH_TALLY_ADAPTER_URL=
GRAPH_TALLY_ADAPTER_TOKEN=
GRAPH_TALLY_CHAIN_ID=
GRAPH_TALLY_VERIFYING_CONTRACT=
GRAPH_TALLY_DOMAIN_NAME=
GRAPH_TALLY_DOMAIN_VERSION=
GRAPH_TALLY_COLLECTION_ID=
GRAPH_TALLY_DATA_SERVICE=
GRAPH_TALLY_MAX_AGE_SECONDS=300
