# Public values are bundled into the browser; never put private keys here.
NEXT_PUBLIC_ROUTER_ADDRESS=
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_REPUTATION_REGISTRY_ADDRESS=
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=
# Public RPC for wallet simulation and receipt tracking.
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Server-only RPC may use a private provider key.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Start block of YOUR deployment (the testnet has reset before).
DEPLOYMENT_BLOCK=0
EVENT_LOOKBACK_BLOCKS=200
# Only ipfs:// cards are retrieved, through this configured gateway.
IPFS_GATEWAY=https://ipfs.io/ipfs/
