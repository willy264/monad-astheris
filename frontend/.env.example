# Public values are bundled into the browser; never put private keys here.
NEXT_PUBLIC_ROUTER_ADDRESS=
NEXT_PUBLIC_AGENT_REGISTRY_ADDRESS=
NEXT_PUBLIC_REPUTATION_REGISTRY_ADDRESS=
NEXT_PUBLIC_DYNAMIC_ENVIRONMENT_ID=
# Mera is separate from Dynamic. Enable only on the stable HTTPS passkey origin.
NEXT_PUBLIC_MERA_ENABLED=false
# Empty uses the current hostname. Changing RP ID changes which passkeys can sign in.
NEXT_PUBLIC_MERA_RP_ID=
# Public RPC for wallet simulation and receipt tracking.
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Server-only RPC may use a private provider key.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Start block of YOUR deployment (the testnet has reset before).
DEPLOYMENT_BLOCK=0
EVENT_LOOKBACK_BLOCKS=200
# Only ipfs:// cards are retrieved, through this configured gateway.
IPFS_GATEWAY=https://ipfs.io/ipfs/
# Server-only Envio/Hasura endpoint; empty selects explicitly labeled RPC fallback.
# A configured but failing endpoint produces an error, not a silent RPC fallback.
ENVIO_GRAPHQL_URL=
# Optional server-only access credentials. Never use NEXT_PUBLIC_ for these.
ENVIO_GRAPHQL_ADMIN_SECRET=
ENVIO_GRAPHQL_TOKEN=

# Optional browser demo. All variables below are server-only; no private keys.
# Leave disabled until the deployment, delegates and real payment service work.
DEMO_ENABLED=false
DAEMON_URL=http://127.0.0.1:8080
DEMO_AGENT_ID=
# Exact resource URL advertised by the daemon's x402 requirements.
DEMO_TASK_RESOURCE=
DEMO_PAYMENT_ASSET=
DEMO_PAYMENT_RECEIVER=
# Maximum per-task payment in token base units. The demo submits five tasks.
DEMO_PAYMENT_MAX_AMOUNT=
DEMO_PAYMENT_ASSET_NAME=
DEMO_PAYMENT_ASSET_VERSION=
