# Node 22+; this file is copied to scripts/.env. Never commit credentials.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# Funded agent owner, distinct from a daemon relayer if used for future paid tasks.
# Required for registration; use 0x followed by exactly 64 hexadecimal characters.
AGENT_OWNER_PRIVATE_KEY=
# Optional public owner for prepare-only; must match the registration signer later.
AGENT_OWNER_ADDRESS=
AGENT_NAME=Aetheris Monad Observer
AGENT_DESCRIPTION="Reports the latest Monad Testnet block number, hash, timestamp and transaction count through MCP. This read-only service does not submit transactions or execute paid autonomous tasks."
# Replace capabilities with exactly the tools supported by the deployed endpoint.
AGENT_CAPABILITIES=get_monad_block
MCP_ENDPOINT=https://monad-astheris.vercel.app/api/mcp
# Optional public HTTPS image, stored in the Agent Card's image field.
AGENT_IMAGE_URL=https://monad-astheris.vercel.app/brand/aetheris-logo.png
# This observer endpoint is free to read; do not claim x402 service support.
AGENT_SERVICE_X402_SUPPORT=false
# Pinata JWT with permission to upload public files.
PINATA_JWT=
IPFS_GATEWAY=https://ipfs.io/ipfs/
