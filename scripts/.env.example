# Task client: Node 22; loaded from scripts/.env. Never commit real keys or tokens.
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
AETHERIS_ROUTER_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=
AGENT_ID=
EXECUTOR_ADDRESS=
# Authorized EOA owner/delegate; MUST NOT be any daemon relayer key.
TASK_SIGNER_PRIVATE_KEY=
TASK_SEQUENCE_NONCE=0
# Optional fixed bytes32; otherwise generated once and persisted in --run-dir.
TASK_ID=
TASK_CONFIRMATIONS=12
DAEMON_URL=http://127.0.0.1:8080
# Exact public MCP Streamable HTTP endpoint, no query/embedded credentials.
MCP_SERVER_URL=
MCP_TOOL_NAME=
MCP_ARGUMENTS_FILE=
MCP_BEARER_TOKEN=
# Actual x402 v2 exact/EIP3009 token/domain/receiver, pinned independently of server.
PAYMENT_MODE=x402
PAYMENT_ASSET=
PAYMENT_ASSET_NAME=
PAYMENT_ASSET_VERSION=
PAYMENT_RECEIVER=
# Explicit maximum base-unit amount; no default spending authorization.
PAYMENT_MAX_AMOUNT=
PAYMENT_MAX_TIMEOUT_SECONDS=120
# Optional independent, eligible reviewer. Both values required together.
REVIEWER_PRIVATE_KEY=
REVIEW_ASSESSMENT_FILE=

# Deployment uses contracts/.env PRIVATE_KEY or an already-set environment variable.
# Registration uses an independent funded owner; no keys have been generated for you.
AGENT_OWNER_PRIVATE_KEY=
# Optional owner address for prepare-only (must match registration signer later).
AGENT_OWNER_ADDRESS=
AGENT_NAME=
AGENT_DESCRIPTION=
AGENT_CAPABILITIES=
# Public HTTPS endpoint published on the Agent Card; usually MCP_SERVER_URL above.
MCP_ENDPOINT=
AGENT_SERVICE_X402_SUPPORT=false
PINATA_JWT=
IPFS_GATEWAY=https://ipfs.io/ipfs/
# Proof collection, after submit-task succeeds. Hasura secret is server-only.
TASK_PROOF_PATH=
ENVIO_GRAPHQL_URL=
ENVIO_GRAPHQL_ADMIN_SECRET=
